{
  "name": "pinplanet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cache:build": "tsx scripts/cache/build.ts",
    "cache:dev": "tsx scripts/cache/build.ts --limit=12",
    "seeds:images": "tsx scripts/cache/seedImages.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
